  "dialogue": [
    {
      "id": "intro1",
      "speaker": "raynor",
      "text": "Let's show these people they don't have to be afraid of the Dominion.",
      "source": "paraphrase"
    },
    {
      "id": "intro2",
      "speaker": "adjutant",
      "text": "Commander, tutorial videos are available any time from the help menu.",
      "source": "paraphrase"
    },
    { "id": "move", "speaker": "raynor", "text": "Spread out, keep your eyes open. Move out.", "source": "paraphrase" },
    {
      "id": "warn",
      "speaker": "civilian",
      "text": "Mister, I wouldn't go up that road. Dominion's all over it.",
      "source": "paraphrase"
    },
    { "id": "contact", "speaker": "dominion", "text": "Hey, that's Jim Raynor! Take him out!", "source": "paraphrase" },
    {
      "id": "mengsk1",
      "speaker": "mengsk",
      "text": "Keep watch on your neighbours. Report suspicious activity to the Dominion.",
      "source": "paraphrase"
    },
    {
      "id": "bonus",
      "speaker": "adjutant",
      "text": "Destroying the Dominion holoboards will stir the population to rebel.",
      "source": "paraphrase"
    },
    {
      "id": "blast",
      "speaker": "raynor",
      "text": "I'm tired of looking at Mengsk's face. Blow it up.",
      "source": "paraphrase"
    },
    { "id": "where", "speaker": "raynor", "text": "Where'd everybody go?", "source": "paraphrase" },
    {
      "id": "family",
      "speaker": "civilian2",
      "text": "They took my neighbours... my whole family...",
      "source": "paraphrase"
    },
    { "id": "ugly", "speaker": "raynor", "text": "This is turning ugly.", "source": "paraphrase" },
    {
      "id": "force",
      "speaker": "adjutant",
      "text": "Warning: a large Dominion force is massing in the centre of town.",
      "source": "paraphrase"
    },
    {
      "id": "delivery",
      "speaker": "raynor",
      "text": "Time for that special delivery. Bring 'em down!",
      "source": "paraphrase"
    },
    {
      "id": "thanks",
      "speaker": "raider",
      "text": "Thanks for the lift, Commander. We're with you.",
      "source": "paraphrase"
    },
    {
      "id": "wanted",
      "speaker": "dominion",
      "text": "It's Raynor! The most wanted man in the sector!",
      "source": "paraphrase"
    },
    {
      "id": "mengsk2",
      "speaker": "mengsk",
      "text": "Every citizen must be ready to sacrifice for the common good.",
      "source": "paraphrase"
    },
    {
      "id": "mengsk3",
      "speaker": "mengsk",
      "text": "The Dominion keeps your communities safe.",
      "source": "paraphrase"
    },
    {
      "id": "mengsk4",
      "speaker": "mengsk",
      "text": "Your freedoms are precious. The Dominion will protect them.",
      "source": "paraphrase"
    },
    { "id": "bad", "speaker": "raynor", "text": "This doesn't look good.", "source": "paraphrase" },
    { "id": "locals", "speaker": "raynor", "text": "There they are. The townsfolk.", "source": "paraphrase" },
    {
      "id": "cut1",
      "speaker": "dominion",
      "text": "Line up. Everyone who signs on for the dig site gets a hot meal.",
      "source": "paraphrase"
    },
    {
      "id": "cut2",
      "speaker": "civilian",
      "text": "My brother went to that mine and never came back. I'm not going!",
      "source": "paraphrase"
    },
    { "id": "cut3", "speaker": "dominion", "text": "Runner! Stop him!", "source": "paraphrase" },
    {
      "id": "shoot",
      "speaker": "raynor",
      "text": "They're gunning down civilians! Move in, now!",
      "source": "paraphrase"
    },
    { "id": "pay", "speaker": "raynor", "text": "Mengsk's got a lot to answer for.", "source": "paraphrase" },
    {
      "id": "thanksR",
      "speaker": "civilian2",
      "text": "Thank you, Raynor! They're holding more of us up ahead.",
      "source": "paraphrase"
    },
    { "id": "seeto", "speaker": "raynor", "text": "I'll take care of it.", "source": "paraphrase" },
    {
      "id": "noreturn",
      "speaker": "adjutant",
      "text": "Commander, once we push north there is no turning back.",
      "source": "UNVERIFIED"
    },
    {
      "id": "mengsk5",
      "speaker": "mengsk",
      "text": "Serve your Emperor. Join an official Dominion labour program.",
